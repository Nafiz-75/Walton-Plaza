{
  "name": "walton-plaza-redesign",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web && node -e \"require('fs').cpSync('public/img','dist-web/img',{recursive:true})\"",
    "build:all": "npm run build && npm run build:web",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "framer-motion": "^12.23.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.0",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
